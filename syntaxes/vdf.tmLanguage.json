{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "VDF",
	"scopeName": "source.vdf",
	"patterns": [
		{ "include": "#comment" },
		{ "include": "#blockPair" },
		{ "include": "#stringPair" },
		{ "include": "#string" }
	],
	"repository": {
		"comment": {
			"match": "//.*$",
			"name": "comment.line.double-slash.vdf"
		},
		"blockPair": {
			"begin": "(\"[^\"]+\")\\s*(\\{)",
			"beginCaptures": {
				"1": { "name": "entity.name.tag.key.vdf" },
				"2": { "name": "punctuation.section.block.begin.vdf" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "punctuation.section.block.end.vdf" }
			},
			"name": "meta.block.vdf",
			"patterns": [
				{ "include": "$self" }
			]
		},
		"stringPair": {
			"match": "(\"[^\"]+\")\\s+(\"[^\"]+\")",
			"captures": {
				"1": { "name": "entity.name.tag.key.vdf" },
				"2": { "name": "string.quoted.double.value.vdf" }
			}
		},
		"string": {
			"match": "\"[^\"]*\"",
			"name": "string.quoted.double.vdf"
		}
	}
}
